# Copy to .env (or better: run `python -m backend.set_api_key`). .env is excluded from Git.
# Everything here is read only by the server; nothing is ever sent to the browser.

# SQLite database location (relative paths are resolved from the project root)
DATABASE_URL=sqlite:///data/platform.db

# openai | anthropic
AI_PROVIDER=openai

# Set keys with `python -m backend.set_api_key` rather than typing them here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the model (defaults: gpt-5.5 for openai, claude-opus-5-5 for anthropic)
AI_MODEL=
# Reasoning depth. OpenAI: minimal | low | medium | high. Anthropic: low | medium | high | xhigh | max
AI_EFFORT=high
# Quicker in-game turns (chat replies, deliverable reviews)
AI_FAST_EFFORT=medium
AI_TIMEOUT_SECONDS=300
